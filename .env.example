# Copy to .env and fill in. Keys come from RevenueCat → Project settings → API keys.
# Test Store key (starts with test_). Used in development, works in Expo Go.
EXPO_PUBLIC_RC_TEST_KEY=
# Platform keys (appl_... / goog_...). Used in release builds.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
